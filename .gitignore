# Outputs are regenerated by running the tool, never committed
out/
outputs/
raw/
# ... except the five demo documents the clean-clone walk-through runs Extraction on (6 MB)
!demo_data/mini_raw/raw/
!demo_data/mini_raw/raw/**
logs/
*.log
handoff2/

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/

# Anything carrying credentials must never land here
*.env
!*.env.example
.env
# provider keys for test runs on one machine (also caught by *.env; named so the rule cannot be lost)
keys.local.env

# OS clutter
Thumbs.db
.DS_Store
desktop.ini

# Host material. The repository is public at the release tag; ESCAP's workbooks are theirs.
# A reviewer places their own copy at the path the README documents.
**/Round1_Baseline_Database.xlsx
**/Round2_Methodology_and_Examples.xlsx
**/ESCAP-RDTII-2.1*
**/OUTPUT_TEMPLATE*.xlsx
**/Data_collection_practice_dataset.xlsx

# Documents collected by hand for Extraction stay on the machine; the README that explains the folder is tracked
inbox/*
!inbox/README.md
