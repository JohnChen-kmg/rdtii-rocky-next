# P2 — OCR & Tag Extraction  (copy to .env; never commit .env)

# --- input / output seams (contract §2, §3) ---
HANDOFF1_DIR=../rdtii-p1-scrape/handoff1_v2
OUT_DIR=../handoff2
CONTRACT_VERSION=0.2.0

# --- OCR (contract §5.1; default set by the CER pilot outcome) ---
OCR_ENGINE=tesseract            # tesseract | paddleocr | azure_docint
OCR_LANG=eng
AZURE_DOCINT_KEY=
AZURE_DOCINT_ENDPOINT=

# --- LLM for tag extraction (soft hints only — local-first) ---
LLM_PROVIDER=ollama             # ollama | anthropic  (auto-falls back to ollama if key empty)
LLM_MODEL=qwen2.5:14b           # dev-GPU tagging model; judge box uses llama3.1:8b
ANTHROPIC_API_KEY=              # reviewer supplies their own; leave empty in repo
OLLAMA_HOST=http://localhost:11434
TAG_BATCH_SIZE=1                # provisions per tagging call; set 10 for anthropic runs
                                # (3.3x fewer input tokens; no local speed gain - measured)

# --- native-PDF scanned-detection threshold (contract §2.3) ---
NATIVE_TEXT_CHARS_PER_PAGE_MIN=100
