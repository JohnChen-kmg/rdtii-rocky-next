# RDTII Project 1 — crawler config (copy to .env to override).
# Every engine/threshold choice is a config VALUE, not a code change
# (modular-backend rubric item). P1 uses ONLY the crawler subset below;
# LLM/OCR keys (LLM_PROVIDER, OCR_ENGINE, ANTHROPIC_API_KEY, …) belong to P2/P3.

# --- Seam version (MAJOR-gated by validate) ---
CONTRACT_VERSION=0.2.0

# --- Crawl engine ---
CRAWL_ENGINE=playwright            # playwright | requests | httpx (fallbacks)

# --- Classifier (§2.3) ---
SCAN_CHAR_THRESHOLD=100            # mean extractable chars/page >= this => pdf_native

# --- Politeness / rate limiting (§5.1) ---
REQUEST_DELAY_MS=2000              # ~1 request / 2s per host
MAX_CONCURRENCY_PER_HOST=1
FETCH_TIMEOUT_MS=45000             # per-URL wall budget
FETCH_RETRIES=3
USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36 RDTII-Rocky-Crawler/0.1 (+contact: jiaxiangchen.kmg@gmail.com)

# --- robots stance (§5.1) ---
RESPECT_ROBOTS_FOR_DISCOVERY=true  # advisory scope-guidance for search/discovery paths
ROBOTS_HARD_BLOCK=false            # seed-law canonical (public statute) URLs never hard-blocked

# --- Recall guardrails (§4) ---
MAX_CANDIDATES_PER_ECONOMY=60
CRAWL_DEPTH_MAX=2
