# P3 — Mapping to the RDTII Index  (copy to .env; never commit .env)

# --- LLM backends (contract §5.1) ---
# A missing key is REFUSED for mapping, verification and tie-breaks: decision #3 reserves those
# roles for a hosted model, and Round 1's silent fallback to a local model would have filed rows
# from a model neither declared engine names. Ask for the local engine explicitly instead.
# One name an interface can set: A = hosted Claude, B = open weights, both declared in
# config/llm/engines.json with engine B pinned by digest. Leave it EMPTY and the stage reads
# LLM_PROVIDER and the four model variables exactly as it did before engines existed.
RDTII_ENGINE=
ANTHROPIC_API_KEY=                    # reviewer supplies their own
LLM_PROVIDER=anthropic                # anthropic | ollama  (used when RDTII_ENGINE is empty)
LLM_MODEL=claude-sonnet-5             # mapper (bare alias — no date suffix exists; record run date in model_version)
VERIFIER_MODEL=claude-haiku-4-5       # blind verify (LegalBench 81.2 vs Sonnet 83.9 at 1/3 price)
ESCALATION_MODEL=claude-opus-4-8      # mapper/verifier disagreement tiebreak
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5:14b              # the judging model when LLM_PROVIDER=ollama
OLLAMA_NUM_CTX=16384                  # Ollama defaults to 2048 and truncates from the FRONT,
                                      # which drops the indicator definition and keeps the
                                      # provision: 2,200 chars of Lao is ~2,730 tokens
TRIAGE_MODEL=qwen2.5:14b              # S3 local triage (never maps/verifies)

# --- prefilter ---
EMBED_MODEL=BAAI/bge-m3               # multilingual: this is the leg that sees CN, LA and TL
PREFILTER_SPARSE=bm25s
PREFILTER_TOPK=150000                 # how deep each leg stores its ranking, per indicator.
                                      # At 50,000 the cut sat ABOVE theta for 7.3 and 7.5, so the
                                      # index decided those cells instead of the threshold.
PREFILTER_FLOOR=0.0001                # gray-band RRF floor, caps mode only; 0.008 empties it
SELECT_MODE=scores                    # scores = the measured thresholds | caps = Round 1's fixed caps
SELECTION_CONFIG=                     # alternative parameter file; empty = config/selection.json
EMBED_DEVICE=cuda                     # cuda | cpu
EMBED_BATCH=128
EMBED_MAX_TOKENS=512                  # read directly by prefilter/dense.py, not via settings

# --- input seams ---
# HANDOFF2_DIR has no safe default: the old one still holds Round 1's July output, and a run
# that forgets it reads 411,986 stale provisions and looks entirely healthy.
HANDOFF2_DIR=../handoff2
MANIFEST_PATH=../rdtii-p1-scrape/handoff1_v2/manifest.csv
INSTRUMENT_DIR=contracts/instrument   # vendored copy of p0-instrument/output (pinned)
BASELINE_PATH=reference/Round1_Baseline_Database.xlsx                   # AU, MY, SG
BASELINE_R2_PATH=reference/rdtii_official/ESCAP-RDTII-2.1_ Round 2 Database.xlsx   # CN, LA
# Timor-Leste appears in neither book, so every TL row is NEW and its Notes must say why.

# --- run scope ---
# Empty means every economy the corpus holds. Set it to scope a run without touching code,
# which is how the sealed 15 October task is handled.
ECONOMIES=                            # e.g. CN,LA,TL
# The indicator set for one run. Empty = the instrument's automated set (pillars 6 and 7, nine
# indicators). Widen it for a full-instrument run, or narrow it when the 15 October draw names
# specific cells. A name the instrument does not carry is refused, not skipped.
#   INDICATORS_SCOPE=6.1,7.5        -> those two only
#   INDICATORS_SCOPE=<all 61>       -> the full instrument (used for Timor-Leste, 28 September)
INDICATORS_SCOPE=

# --- output + guardrails ---
# RUN_ID names the run in the manifest, and through it in Section 2 and the live-test note.
# Empty falls back to the run directory's name, which is what distinguishes two runs here.
RUN_ID=
OUT_DIR=out
INDEX_DIR=data/index
CONTRACT_VERSION=0.3.0                # the corpus the finale hands over
INGEST_GATE=on                        # off = report S0 contract failures and continue (plumbing only)
MAX_COST_USD_PER_DOC=0.25
COST_HARD_STOP=400
NEWKNOWN_SIM=0.85                     # law-name similarity that makes a fire KNOWN
EXEMPLAR_PROFILE=production           # production | eval (decision #12)

# --- what reaches the CSV ---
# These were constants in output/submission.py until 27 September, which put them on the wrong side
# of the code freeze: the live test is the run most likely to need them moved. Defaults are Round 1's
# values exactly, so leaving them alone changes nothing.
NEW_CONF=0.75                         # minimum mapper confidence for a NEW row
NEW_CAP=8                             # NEW rows per (economy, indicator). On 15 October the draw is
                                      #   one economy and two indicators, so this caps the live
                                      #   export at roughly 16-20 NEW rows however much is found --
                                      #   raise it before the hour, not during it
NEW_CAP_TAIL=10                       # the same, for the multi-row cells 7.3 and 7.5
SECTORAL_MAX=3                        # sectoral records per cell that reach the CSV (framework 2.4)

# --- thread counts for the three paid stages ---
# The live hour is rate-limit-bound, not compute-bound, so these are the dial that helps. Lower them
# if the provider returns 429s; raising them past the account's limit makes the hour slower, not faster.
TRIAGE_WORKERS=12
MAP_WORKERS=8
VERIFY_WORKERS=8

# --- the third-provider A/B harness (src/p3map/ab/ab_deepseek.py) ---
# An experiment, not a pipeline stage: the mapper never reaches an OpenAI-compatible endpoint
# through these. Kept documented because Section 5 cites the A/B's pre-registration.
AB3_BASE_URL=https://api.deepseek.com/v1
AB3_API_KEY=
AB3_MODEL=deepseek-chat
AB3_MODEL_THINK=deepseek-reasoner
AB3_WORKERS=4
AB3_BUDGET_USD=5
